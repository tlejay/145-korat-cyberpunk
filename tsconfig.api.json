{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["api", "db", "src/net/score.ts", "src/net/codes.ts", "src/net/name.ts", "src/net/bad-words.ts", "src/net/ghost-format.ts", "src/version.ts", "drizzle.config.ts"]
}
